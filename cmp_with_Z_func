#include <iostream>
#include <vector>

using namespace std;

using TSize = unsigned int;

struct Position {
    TSize number = 0;
    TSize row = 0;
    TSize column = 0;

    Position() = default;
    Position(TSize number, TSize row, TSize column) : number(number), row(row), column(column) {}
};

bool operator==(const Position& lhs, const Position& rhs) {
    return lhs.number == rhs.number;
}

bool operator!=(const Position& lhs, const Position& rhs) {
    return lhs.number != rhs.number;
}

vector<TSize> ZFunction(const vector<Position>& pattern) {
    const TSize n = pattern.size();
    vector<TSize> z(n, 0);
    z[0] = n;
    TSize left = 0, right = 0;
    for (TSize i = 1; i < n; ++i) {
        if (i <= right) {
            z[i] = min(z[i - left], right - i + 1);
        }
        while (i + z[i] < n && pattern[z[i]] == pattern[i + z[i]]) {
            ++z[i];
        }
        if (i + z[i] - 1 > right) {
            left = i;
            right = i + z[i] - 1;
        }
    }
    return z;
}

vector<TSize> StrongPrefixFunctionWithZ(const vector<Position>& pattern) {
    const vector<TSize> z = ZFunction(pattern);
    const TSize n = pattern.size();
    vector<TSize> prefix(n, 0);
    for (TSize j = n - 1; j >= 1; --j) {
        prefix[j + z[j] - 1] = z[j];
    }
    return prefix;
}

class PositionReader {
public:
    PositionReader() : current(0, 1, 1), end(false) {}

    bool read(Position& position) {
        if (end) {
            return false;
        }
        char c = cin.get();
        bool notNumber = true;
        while (true) {
            if (c == EOF) {
                if (!notNumber) {
                    position = current;
                    current.number = 0;
                    notNumber = true;
                    end = true;
                    break;
                }
                return false;
            }
            if (c == '\n') {
                if (!notNumber) {
                    position = current;
                    current.number = 0;
                    notNumber = true;
                    ++current.row;
                    current.column = 1;
                    break;
                }
                ++current.row;
                current.column = 1;
            } else if (c == '\t' || c == ' ') {
                if (!notNumber) {
                    position = current;
                    current.number = 0;
                    notNumber = true;
                    ++current.column;
                    break;
                }
            } else {
                if (isdigit(c)) {
                    current.number = current.number * 10 + (c - '0');
                }
                notNumber = false;
            }
            c = cin.get();
        }
        return true;
    }

private:
    Position current;
    bool end;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    vector<Position> pattern;
    Position currentPosition;
    char c = cin.get();
    bool notNumber = true;
    while (true) {
        if (c == '\n') {
            if (!notNumber) {
                pattern.emplace_back(currentPosition);
                currentPosition.number = 0;
                notNumber = true;
            }
            break;
        } else if (c == '\t' || c == ' ') {
            if (!notNumber) {
                pattern.emplace_back(currentPosition);
                currentPosition.number = 0;
                notNumber = true;
            }
        } else {
            if (isdigit(c)) {
                currentPosition.number = currentPosition.number * 10 + (c - '0');
            }
            notNumber = false;
        }
        c = cin.get();
    }

    vector<TSize> prefixFunction = StrongPrefixFunctionWithZ(pattern);

    vector<Position> text(pattern.size());
    PositionReader reader;
    TSize i = 0;
    TSize j = 0;
    const TSize patternSize = pattern.size();
    bool notEndOfFile = reader.read(text[j]);
    while (notEndOfFile) {
        bool needToRead = false;
        if (pattern[j] == text[i] && j < patternSize) {
            ++j;
            needToRead = true;
        } else if (j == 0) {
            needToRead = true;
        } else {
            j = prefixFunction[j - 1];
        }
        if (j == patternSize) {
            cout << text[(i + 1) % patternSize].row << ", " << text[(i + 1) % patternSize].column << "\n";
            j = prefixFunction[j - 1];
        }

        if (needToRead) {
            i = (i + 1) % patternSize;
            notEndOfFile = reader.read(text[i]);
        }
    }

    return 0;
}
